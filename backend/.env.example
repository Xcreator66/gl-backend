DATABASE_URL=postgres://user:pass@localhost:5432/greenloop
JWT_SECRET=change-me-to-a-long-random-string
OTP_MODE=dev            # dev = OTP printed in server log; replace with an SMS provider before pilot
COMMISSION_BPS=500      # collector commission, 5% of household reward pool (admin decision)
TOLERANCE_PCT=2
REDEMPTION_ENABLED=false   # keep false until legal/tax review of GREEN redemption is done
GREEN_PER_INR=10
MIN_REDEEM_GREEN=1000
ADMIN_ORIGIN=http://localhost:5173   # dashboard origin allowed by CORS
NODE_ENV=development
TRUST_PROXY=             # set to 1 behind a load balancer/reverse proxy
SMS_WEBHOOK_URL=         # production OTP: your SMS adapter endpoint (OTP_MODE=webhook)
SMS_WEBHOOK_TOKEN=
# OTP_MODE=test returns the OTP in the API response (non-production only) - used by `npm run smoke`
RATE_LIMIT_MULTIPLIER=   # non-production only (ignored when NODE_ENV=production); set 100 when running `npm run smoke`

# Media uploads (v0.31) - private local storage, signed URLs
MEDIA_STORAGE_DIR=./private-media
MEDIA_PUBLIC_ORIGIN=     # set to the API origin reachable from phones if different from localhost
MEDIA_SIGNING_SECRET=    # separate random secret; falls back to JWT_SECRET if empty
MEDIA_FFPROBE_PATH=ffprobe
MEDIA_FFMPEG_PATH=ffmpeg

# Leaderboard history (v0.31-dev.2): the server closes each finished week and month once, automatically. Set false to close periods only from the admin dashboard.
SNAPSHOT_AUTO=true
